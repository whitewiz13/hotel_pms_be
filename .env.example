# Server
SERVER_PORT=8080
GIN_MODE=debug

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hotel_pms
DB_SSLMODE=disable
DB_TIMEZONE=UTC

# JWT
JWT_SECRET=change-this-to-a-strong-secret-in-production
JWT_EXPIRY_HOURS=24
JWT_GUEST_EXPIRY_HOURS=12

# Migrations
RUN_MIGRATIONS=true

# Seed
SEED_DB=false
